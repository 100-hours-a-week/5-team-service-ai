FROM runpod/pytorch:2.1.0-py3.10-cuda11.8.0-devel

WORKDIR /app

COPY requirements-serverless.txt /app/requirements-serverless.txt

# 기존 torch 제거 후 CUDA 11.8용 torch 2.4.x 재설치
RUN pip uninstall -y torch torchvision torchaudio || true && \
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu118 \
    torch==2.4.1 torchvision==0.19.1 torchaudio==2.4.1 && \
    pip install --no-cache-dir -r /app/requirements-serverless.txt

COPY handler.py /app/handler.py

CMD ["python", "-u", "/app/handler.py"]
